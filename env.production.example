# ============================================================
# HireMatch — Production Environment Variables
# ============================================================
# Copy this to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ============================================================

# ── Supabase ────────────────────────────────────────────────
# Project URL from Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Anon (public) key — safe for browser, enforces RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key — bypasses RLS, server-side only
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Stripe (Recruiter Billing) ──────────────────────────────
# Secret key from Stripe dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
# Webhook signing secret from Stripe dashboard → Webhooks → endpoint
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs for recruiter subscription tiers (Products → Pricing)
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...
STRIPE_PRICE_AGENCY=price_...

# ── AI / Gemini ─────────────────────────────────────────────
# Google AI Studio API key — used for CV parsing, JD parsing, match scoring, visa analysis
GEMINI_API_KEY=AIza...

# ── Cron & Internal Auth ────────────────────────────────────
# Shared secret for authenticating Vercel cron jobs (job-sync, visa-refresh, visa-seed)
CRON_SECRET=your-random-cron-secret

# ── VPS Scraper ─────────────────────────────────────────────
# Shared secret for authenticating visa data ingestion from the VPS scraper (187.77.138.237)
VPS_SCRAPER_SECRET=your-random-scraper-secret

# ── SEO / Site URL ──────────────────────────────────────────
# Canonical site URL — used in sitemap.ts, robots.ts, structured data, Open Graph
NEXT_PUBLIC_SITE_URL=https://www.hirematch.com

# ── Email (Resend) ──────────────────────────────────────────
# Resend API key — transactional emails (welcome, password reset, application notifications)
RESEND_API_KEY=re_...
# From address for outgoing emails
EMAIL_FROM=HireMatch <noreply@hirematch.app>
# App URL used in email links (buttons, reset links)
NEXT_PUBLIC_APP_URL=https://hirematch-ten.vercel.app
# Recipient for ops alert emails (src/lib/alerts.ts)
ALERT_EMAIL_TO=ops@hirematch.app

# ── Alerts / Slack ──────────────────────────────────────────
# Incoming Webhook URL for Slack alert channel
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# ── Error Tracking (Sentry) ─────────────────────────────────
# Sentry DSN — server-side and client-side error tracking
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ── Monitoring (Checkly / Health Checks) ─────────────────────
# Webhook URL for health check alerts (src/lib/checkly.ts)
CHECKLY_WEBHOOK_URL=https://...
# Alternative name accepted by checkly.ts
# MONITORING_WEBHOOK_URL=https://...

# ── Upstash Redis (rate limiting, health checks) ────────────
# REST API URL and token from Upstash console (used in checkly.ts, middleware)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins for API CORS (middleware.ts)
# Use * to allow all origins (default)
API_CORS_ORIGINS=https://www.hirematch.com,https://hirematch-ten.vercel.app

# ── Job Sync APIs (Phase 7 — not yet implemented) ───────────
# Uncomment and fill these when job sync cron is built
# RAPIDAPI_KEY=...
# ADZUNA_APP_ID=...
# ADZUNA_API_KEY=...

# ============================================================
# Worker / Microservice Environment Variables
# (Only needed if running apps/worker, apps/scraper, etc.)
# ============================================================

# ── Redis (BullMQ queues) ───────────────────────────────────
# REDIS_URL=redis://127.0.0.1:6379

# ── Worker Tuning ───────────────────────────────────────────
# EMBED_CONCURRENCY=5
# WEBHOOK_CONCURRENCY=10
# WEBHOOK_TIMEOUT_MS=10000
# SCRAPER_CONCURRENCY=3
# AGENT_CONCURRENCY=2
# AGENT_MAX_STEPS=30
# AGENT_STEP_TIMEOUT=30000
# LOG_LEVEL=info

# ── Bright Data Proxy (apps/scraper) ────────────────────────
# BRIGHT_DATA_HOST=brd.superproxy.io
# BRIGHT_DATA_PORT=9222
# BRIGHT_DATA_USERNAME=...
# BRIGHT_DATA_PASSWORD=...
# BRIGHT_DATA_WS=...
# BRIGHT_DATA_API_TOKEN=...

# ── MinIO Object Storage (apps/scraper, apps/cowork-agent) ──
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=...
# MINIO_SECRET_KEY=...
# MINIO_BUCKET=recruitment-scraper

# ── Anthropic (apps/cowork-agent) ───────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-20250514

# ── Embedding Model (apps/worker) ───────────────────────────
# EMBEDDING_MODEL=text-embedding-004
# GOOGLE_API_KEY=...  (fallback for GEMINI_API_KEY in worker)

# ── V1 API (wip-v1-api) ─────────────────────────────────────
# API_JWT_SECRET=...
# DATABASE_URL=postgresql://...

# ── Scheduler (apps/scheduler) ──────────────────────────────
# POLL_CRON=* * * * *
