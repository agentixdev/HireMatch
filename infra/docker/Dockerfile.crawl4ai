# =============================================================================
# Dockerfile.crawl4ai — Python 3.12 + FastAPI + Crawl4AI deep web crawler
# =============================================================================

# -- Stage 1: Build Python dependencies ---------------------------------------
FROM python:3.12-slim-bookworm AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    libffi-dev \
 && rm -rf /var/lib/apt/lists/*

COPY infra/docker/requirements.crawl4ai.txt requirements.txt

RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# -- Stage 2: Runtime ----------------------------------------------------------
FROM python:3.12-slim-bookworm AS runtime

# Playwright system dependencies for Crawl4AI browser automation
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    xdg-utils \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /install /usr/local

# Install Playwright Chromium for Crawl4AI
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN playwright install --with-deps chromium

# Copy application code
COPY infra/docker/crawl4ai_app/ /app/

# Non-root user
RUN groupadd -r crawl4ai && useradd -r -g crawl4ai crawl4ai \
 && mkdir -p /app/cache && chown -R crawl4ai:crawl4ai /app
USER crawl4ai

ENV PYTHONUNBUFFERED=1
EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=30s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8001/health')"

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "2"]
