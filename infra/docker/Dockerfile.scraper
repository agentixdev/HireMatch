# =============================================================================
# Dockerfile.scraper — Playwright + Chromium headless for visa / job scraping
# =============================================================================

# -- Stage 1: Install dependencies -------------------------------------------
FROM node:22-bookworm-slim AS deps

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@9 --activate

# Copy workspace config first for layer caching
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY tsconfig.base.json turbo.json ./

# Copy package manifests only (no source) for all workspace packages
COPY packages/queue/package.json        packages/queue/package.json
COPY packages/shared/package.json       packages/shared/package.json
COPY packages/storage/package.json      packages/storage/package.json
COPY packages/embeddings/package.json   packages/embeddings/package.json
COPY packages/db/package.json           packages/db/package.json

RUN pnpm install --frozen-lockfile --ignore-scripts

# -- Stage 2: Build TypeScript ------------------------------------------------
FROM deps AS builder

COPY packages/shared/     packages/shared/
COPY packages/queue/      packages/queue/
COPY packages/storage/    packages/storage/
COPY packages/embeddings/ packages/embeddings/
COPY packages/db/         packages/db/
COPY src/lib/visa-scraper.ts src/lib/visa-scraper.ts

RUN pnpm --filter @recruitment/shared build \
 && pnpm --filter @recruitment/queue build \
 && pnpm --filter @recruitment/storage build \
 && pnpm --filter @recruitment/embeddings build

# -- Stage 3: Production image with Playwright --------------------------------
FROM node:22-bookworm-slim AS runtime

RUN corepack enable && corepack prepare pnpm@9 --activate

# Playwright system dependencies + Chromium
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    xdg-utils \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/node_modules        ./node_modules
COPY --from=builder /app/packages             ./packages
COPY --from=builder /app/pnpm-workspace.yaml  ./pnpm-workspace.yaml
COPY --from=builder /app/package.json         ./package.json
COPY --from=builder /app/src/lib/visa-scraper.ts ./src/lib/visa-scraper.ts

# Install Playwright browsers (Chromium only to save space)
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN npx playwright install --with-deps chromium

# Create non-root user
RUN groupadd -r scraper && useradd -r -g scraper -G audio,video scraper \
 && mkdir -p /app/data && chown -R scraper:scraper /app

USER scraper

ENV NODE_ENV=production
EXPOSE 3100

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=20s \
  CMD node -e "require('http').get('http://localhost:3100/health',(r)=>{process.exit(r.statusCode===200?0:1)})"

CMD ["node", "--enable-source-maps", "packages/queue/dist/scraper-entry.js"]
